            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('identityContainerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8080,
            "transport": "auto"
          },
          "registries": [
            {
              "server": "[parameters('ghcrServer')]",
              "username": "[parameters('ghcrUsername')]",
              "passwordSecretRef": "ghcr-password"
            }
          ],
          "secrets": [
            {
              "name": "db-connection-string",
              "value": "[format('Server={0};Database={1};Port=5432;User Id={2};Password={3};Ssl Mode=Require;', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName')), '2023-06-01-preview').fullyQualifiedDomainName, parameters('postgresDatabaseName'), parameters('postgresAdministratorLogin'), parameters('postgresAdministratorPassword'))]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "ghcr-password",
              "value": "[parameters('ghcrPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "identity",
              "image": "[parameters('identityImage')]",
              "env": [
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "ASPNETCORE_URLS",
                  "value": "http://+:8080"
                },
                {
                  "name": "ConnectionStrings__KinHub",
                  "secretRef": "db-connection-string"
                },
                {
                  "name": "Jwt__Secret",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "Jwt__Issuer",
                  "value": "[parameters('jwtIssuer')]"
                },
                {
                  "name": "Jwt__AccessTokenExpiryMinutes",
                  "value": "[parameters('jwtAccessTokenExpiryMinutes')]"
                },
                {
                  "name": "Jwt__RefreshTokenExpiryDays",
                  "value": "[parameters('jwtRefreshTokenExpiryDays')]"
                },
                {
                  "name": "Cors__AllowAnyOrigin",
                  "value": "false"
                },
                {
                  "name": "Cors__AllowedOrigins__0",
                  "value": "[parameters('coreFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__1",
                  "value": "[parameters('identityFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__2",
                  "value": "[parameters('kinRecipeFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__3",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('coreStaticWebAppName')), '2024-04-01').defaultHostname)]"
                },
                {
                  "name": "Cors__AllowedOrigins__4",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('identityStaticWebAppName')), '2024-04-01').defaultHostname)]"
                },
                {
                  "name": "Cors__AllowedOrigins__5",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('kinRecipeStaticWebAppName')), '2024-04-01').defaultHostname)]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', parameters('applicationInsightsName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "[resourceId('Microsoft.Web/staticSites', parameters('coreStaticWebAppName'))]",
        "[resourceId('Microsoft.Web/staticSites', parameters('identityStaticWebAppName'))]",
        "[resourceId('Microsoft.Web/staticSites', parameters('kinRecipeStaticWebAppName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('kinRecipeContainerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8080,
            "transport": "auto"
          },
          "registries": [
            {
              "server": "[parameters('ghcrServer')]",
              "username": "[parameters('ghcrUsername')]",
              "passwordSecretRef": "ghcr-password"
            }
          ],
          "secrets": [
            {
              "name": "db-connection-string",
              "value": "[format('Server={0};Database={1};Port=5432;User Id={2};Password={3};Ssl Mode=Require;', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName')), '2023-06-01-preview').fullyQualifiedDomainName, parameters('postgresDatabaseName'), parameters('postgresAdministratorLogin'), parameters('postgresAdministratorPassword'))]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "openai-endpoint",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiAccountName')), '2023-05-01').endpoint]"
            },
            {
              "name": "openai-key",
              "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiAccountName')), '2023-05-01').key1]"
            },
            {
              "name": "ghcr-password",
              "value": "[parameters('ghcrPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "kinrecipe",
              "image": "[parameters('kinRecipeImage')]",
              "env": [
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "ASPNETCORE_URLS",
                  "value": "http://+:8080"
                },
                {
                  "name": "ConnectionStrings__KinHub",
                  "secretRef": "db-connection-string"
                },
                {
                  "name": "Jwt__Secret",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "Jwt__Issuer",
                  "value": "[parameters('jwtIssuer')]"
                },
                {
                  "name": "Jwt__AccessTokenExpiryMinutes",
                  "value": "[parameters('jwtAccessTokenExpiryMinutes')]"
                },
                {
                  "name": "Jwt__RefreshTokenExpiryDays",
                  "value": "[parameters('jwtRefreshTokenExpiryDays')]"
                },
                {
                  "name": "OpenAi__Endpoint",
                  "secretRef": "openai-endpoint"
                },
                {
                  "name": "OpenAi__ApiKey",
                  "secretRef": "openai-key"
                },
                {
                  "name": "OpenAi__EmbeddingDeploymentName",
                  "value": "text-embedding-3-small"
                },
                {
                  "name": "OpenAi__ModelDeploymentName",
                  "value": "gpt-4o-mini"
                },
                {
                  "name": "Cors__AllowAnyOrigin",
                  "value": "false"
                },
                {
                  "name": "Cors__AllowedOrigins__0",
                  "value": "[parameters('coreFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__1",
                  "value": "[parameters('identityFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__2",
                  "value": "[parameters('kinRecipeFrontendOrigin')]"
                },
                {
                  "name": "Cors__AllowedOrigins__3",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('coreStaticWebAppName')), '2024-04-01').defaultHostname)]"
                },
                {
                  "name": "Cors__AllowedOrigins__4",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('identityStaticWebAppName')), '2024-04-01').defaultHostname)]"
                },
                {
                  "name": "Cors__AllowedOrigins__5",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('kinRecipeStaticWebAppName')), '2024-04-01').defaultHostname)]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
