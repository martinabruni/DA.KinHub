{
  "KinHub": {
    "AppName": "KinHub",
    "Environment": "Production",
    "ApiVersion": "1.0"
  },
  "Entra": {
    "Enabled": true,
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "<ENTRA_TENANT_ID>",
    "Audience": "<ENTRA_BACKEND_CLIENT_ID_OR_AUDIENCE>",
    "Scope": "<ENTRA_API_SCOPE>"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "Storage": {
    "AccountUri": "https://<STORAGE_ACCOUNT_NAME>.blob.core.windows.net/",
    "ContainerName": "documents"
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=<POSTGRES_HOST>;Database=kinhub;Username=<POSTGRES_USERNAME>;Password=<POSTGRES_PASSWORD>;SSL Mode=Require"
  }
}
