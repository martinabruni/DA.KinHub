{
  "KinHub": {
    "Environment": "Development"
  },
  "Entra": {
    "Enabled": false,
    "TenantId": "common",
    "Audience": "api://kinhub-local",
    "Scope": "access_as_user"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "documents"
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=kinhub;Username=kinhub;Password=kinhub"
  }
}
