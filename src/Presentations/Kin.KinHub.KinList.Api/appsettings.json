{
  "ConnectionStrings": {
    "KinHub": ""
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowAnyOrigin": true
  },
  "Jwt": {
    "Issuer": "kinhub-development",
    "Secret": "development-only-kinhub-jwt-secret-0001",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 30
  },
  "CoreApi": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 10
  },
  "KinList": {
    "MaxTitleLength": 100,
    "MaxItemLength": 200,
    "MaxItemsPerList": 100,
    "MaxItemsPerBulkConfirm": 50,
    "IdempotencyRetentionHours": 24,
    "MaxAudioDurationSeconds": 60,
    "MaxAudioBytes": 10485760,
    "AllowedAudioMimeTypes": [
      "audio/webm",
      "video/webm",
      "audio/mp4",
      "audio/x-m4a",
      "audio/m4a",
      "audio/ogg",
      "application/ogg"
    ]
  }
}
