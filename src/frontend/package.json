{
  "name": "kinhub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../tools/docs-sync/index.mjs sync && node ../../tools/release-notes/index.mjs generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "routes:validate": "node scripts/validate-routes.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0",
    "@azure/msal-react": "^3.0.21",
    "@radix-ui/react-accordion": "^1.2.12",
    "i18next": "^25.5.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
